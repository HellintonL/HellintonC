{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar e Executar C",
            "type": "shell",
            "command": "gcc main.c -o main.exe; if ($LASTEXITCODE -eq 0) { .\\main.exe }",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
